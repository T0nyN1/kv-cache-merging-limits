# OS / editors
.DS_Store
.idea/
.vscode/
*.iml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# models, datasets and weights are downloaded, never committed
/models/
/datasets/
*.pt
*.pth
*.bin
*.safetensors
*.gguf

# scratch output of new runs (the released results live in runs/)
results/
outputs/

# local only: logs and job scripts of the follow-up runs (they contain machine paths),
# and superseded measurements kept for the record
runs/*/logs/
runs/*/jobs/
runs/_archive/

# local only: the manuscript, its reviews and submission text.
# Only the scripts that regenerate the paper's figures and tables are published.
/paper/*
!/paper/figures/
/paper/figures/*
!/paper/figures/*.py
